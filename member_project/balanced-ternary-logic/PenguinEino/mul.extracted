* Created by KLayout
*** My special header ***

* cell mul
* pin VDD
* pin VSS
* pin a
* pin b
* pin p
* pin t1
* pin t3
.SUBCKT mul VDD VSS a b p t1 t3
* cell instance $1 r0 *1 240,100
X$1 VDD a b \$4 VSS mul_nor
* cell instance $2 r0 *1 40,100
X$2 VDD a b t1 VSS mul_nand
* cell instance $3 r0 *1 640,100
X$3 VDD t1 t3 p VSS mul_nand
* cell instance $4 r0 *1 440,100
X$4 VDD \$4 t3 VSS mul_inv
.ENDS mul

* cell mul_inv
* pin VDD
* pin vin
* pin vout
* pin VSS
.SUBCKT mul_inv VDD vin vout VSS
* device instance $1 r0 *1 13.2,44 PMOS
XM$1 \$4 vin VDD VDD PMOS L=1u W=13.5u AS=37.8p AD=37.8p PS=32.6u PD=32.6u
* device instance $2 r0 *1 13.2,14 NMOS
XM$2 \$5 vin VSS VSS NMOS L=1u W=5u AS=14p AD=14p PS=15.6u PD=15.6u
* device instance $3 r0 *1 64,32 F_RR
XR$3 \$5 vout VDD F_RR R=10.7142857143 L=30u W=2.8u A=84p P=65.6u m=1
* device instance $4 r0 *1 64,45 F_RR
XR$4 \$4 vout VDD F_RR R=10.7142857143 L=30u W=2.8u A=84p P=65.6u m=1
.ENDS mul_inv

* cell mul_nor
* pin V+
* pin a
* pin b
* pin vout
* pin V-
.SUBCKT mul_nor V+ a b vout V\x2d
* device instance $1 r0 *1 20,96 PMOS
XM$1 \$15 a V+ V+ PMOS L=1u W=37u AS=103.6p AD=103.6p PS=79.6u PD=79.6u
* device instance $2 r0 *1 35,96 PMOS
XM$2 \$3 b \$15 V+ PMOS L=1u W=37u AS=103.6p AD=103.6p PS=79.6u PD=79.6u
* device instance $3 r0 *1 20,16 NMOS
XM$3 \$4 a V\x2d V\x2d NMOS L=1u W=6.5u AS=18.2p AD=18.2p PS=18.6u PD=18.6u
* device instance $4 r0 *1 35,16 NMOS
XM$4 \$4 b V\x2d V\x2d NMOS L=1u W=6.5u AS=18.2p AD=18.2p PS=18.6u PD=18.6u
* device instance $5 r0 *1 90,42 F_RR
XR$5 \$4 vout V+ F_RR R=10.7142857143 L=30u W=2.8u A=84p P=65.6u m=1
* device instance $6 r0 *1 90,78 F_RR
XR$6 \$3 vout V+ F_RR R=10.7142857143 L=30u W=2.8u A=84p P=65.6u m=1
.ENDS mul_nor

* cell mul_nand
* pin V+
* pin a
* pin b
* pin vout
* pin V-
.SUBCKT mul_nand V+ a b vout V\x2d
* device instance $1 r0 *1 20,96 PMOS
XM$1 \$3 a V+ V+ PMOS L=1u W=19u AS=53.2p AD=53.2p PS=43.6u PD=43.6u
* device instance $2 r0 *1 35,96 PMOS
XM$2 \$3 b V+ V+ PMOS L=1u W=19u AS=53.2p AD=53.2p PS=43.6u PD=43.6u
* device instance $3 r0 *1 20,16 NMOS
XM$3 \$15 a \$5 V\x2d NMOS L=1u W=13u AS=36.4p AD=36.4p PS=31.6u PD=31.6u
* device instance $4 r0 *1 35,16 NMOS
XM$4 V\x2d b \$15 V\x2d NMOS L=1u W=13u AS=36.4p AD=36.4p PS=31.6u PD=31.6u
* device instance $5 r0 *1 90,42 F_RR
XR$5 \$5 vout V+ F_RR R=10.7142857143 L=30u W=2.8u A=84p P=65.6u m=1
* device instance $6 r0 *1 90,78 F_RR
XR$6 \$3 vout V+ F_RR R=10.7142857143 L=30u W=2.8u A=84p P=65.6u m=1
.ENDS mul_nand
