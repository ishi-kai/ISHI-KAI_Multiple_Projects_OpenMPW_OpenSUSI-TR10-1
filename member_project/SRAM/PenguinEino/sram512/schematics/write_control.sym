v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=xwrite"
}
P 4 5 -160 -180 160 -180 160 180 -160 180 -160 -180 {}
T {write_control} -140 -20 0 0 0.3 0.3 {}
T {@name} 80 -200 0 0 0.2 0.2 {}
B 5 -182.5 -42.5 -177.5 -37.5 {name=DIN dir=in}
L 4 -180 -40 -160 -40 {}
T {DIN} -150 -45 0 0 0.2 0.2 {}
B 5 -182.5 37.5 -177.5 42.5 {name=WRITE_EN dir=in}
L 4 -180 40 -160 40 {}
T {WRITE_EN} -150 35 0 0 0.2 0.2 {}
B 5 177.5 -132.5 182.5 -127.5 {name=PD_Y dir=out}
L 4 180 -130 160 -130 {}
T {PD_Y} 95 -135 0 0 0.2 0.2 {}
B 5 177.5 137.5 182.5 142.5 {name=PD_YB dir=out}
L 4 180 140 160 140 {}
T {PD_YB} 95 135 0 0 0.2 0.2 {}
B 5 -2.5 -202.5 2.5 -197.5 {name=VDD dir=inout}
L 4 0 -200 0 -180 {}
T {VDD} 10 -170 0 0 0.2 0.2 {}
B 5 -2.5 197.5 2.5 202.5 {name=VSS dir=inout}
L 4 0 200 0 180 {}
T {VSS} 10 155 0 0 0.2 0.2 {}
