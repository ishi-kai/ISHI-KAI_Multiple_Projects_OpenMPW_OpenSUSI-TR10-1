B 5 -162.5 27.5 -157.5 32.5 {name=SDI dir=in}
L 4 -160 30 -140 30 {}
T {SDI} -130 25 0 0 0.2 0.2 {}
B 5 -162.5 87.5 -157.5 92.5 {name=WE dir=in}
L 4 -160 90 -140 90 {}
T {WE} -130 85 0 0 0.2 0.2 {}
B 5 157.5 -2.5 162.5 2.5 {name=SDO dir=out}
L 4 160 0 140 0 {}
T {SDO} 130 -5 0 1 0.2 0.2 {}
B 5 -2.5 -202.5 2.5 -197.5 {name=VDD dir=inout}
L 4 0 -200 0 -180 {}
T {VDD} 8 -172 0 0 0.2 0.2 {}
B 5 -2.5 197.5 2.5 202.5 {name=VSS dir=inout}
L 4 0 200 0 180 {}
