v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
P 4 5 -140 -180 140 -180 140 180 -140 180 -140 -180 {}
T {sram512} -120 -20 0 0 0.3 0.3 {}
