v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=xsa"
}
P 4 5 -130 -100 130 -100 130 100 -130 100 -130 -100 {}
T {sense_amp_7t} -90 -20 0 0 0.3 0.3 {}
T {@name} 100 -120 0 0 0.2 0.2 {}
B 5 -152.5 -62.5 -147.5 -57.5 {name=BL dir=in}
L 4 -130 -60 -150 -60 {}
T {BL} -120 -65 0 0 0.2 0.2 {}
B 5 -152.5 -2.5 -147.5 2.5 {name=BLB dir=in}
L 4 -130 0 -150 0 {}
T {BLB} -120 -5 0 0 0.2 0.2 {}
B 5 -152.5 57.5 -147.5 62.5 {name=SAE dir=in}
L 4 -130 60 -150 60 {}
T {SAE} -120 55 0 0 0.2 0.2 {}
B 5 147.5 -62.5 152.5 -57.5 {name=SOUT dir=out}
L 4 130 -60 150 -60 {}
T {SOUT} 70 -65 0 0 0.2 0.2 {}
B 5 147.5 -2.5 152.5 2.5 {name=SOUTB dir=out}
L 4 130 0 150 0 {}
T {SOUTB} 70 -5 0 0 0.2 0.2 {}
B 5 -2.5 -122.5 2.5 -117.5 {name=VDD dir=inout}
L 4 0 -100 0 -120 {}
T {VDD} 10 -90 0 0 0.2 0.2 {}
B 5 -2.5 117.5 2.5 122.5 {name=VSS dir=inout}
L 4 0 100 0 120 {}
T {VSS} 10 75 0 0 0.2 0.2 {}
