v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=xcol"
}
P 4 5 -160 -180 160 -180 160 180 -160 180 -160 -180 {}
T {col_decoder_1to2} -140 -20 0 0 0.25 0.25 {}
T {@name} 80 -200 0 0 0.2 0.2 {}
B 5 -182.5 -42.5 -177.5 -37.5 {name=CA dir=in}
L 4 -180 -40 -160 -40 {}
T {CA} -150 -45 0 0 0.2 0.2 {}
B 5 177.5 -132.5 182.5 -127.5 {name=COL0 dir=out}
L 4 180 -130 160 -130 {}
T {COL0} 95 -135 0 0 0.2 0.2 {}
B 5 177.5 137.5 182.5 142.5 {name=COL1 dir=out}
L 4 180 140 160 140 {}
T {COL1} 95 135 0 0 0.2 0.2 {}
B 5 -2.5 -202.5 2.5 -197.5 {name=VDD dir=inout}
L 4 0 -200 0 -180 {}
T {VDD} 10 -170 0 0 0.2 0.2 {}
B 5 -2.5 197.5 2.5 202.5 {name=VSS dir=inout}
L 4 0 200 0 180 {}
T {VSS} 10 155 0 0 0.2 0.2 {}
