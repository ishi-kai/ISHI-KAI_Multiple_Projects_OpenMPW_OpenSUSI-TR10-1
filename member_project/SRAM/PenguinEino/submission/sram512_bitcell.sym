v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
P 4 5 -80 -80 80 -80 80 60 -80 60 -80 -80 {}
T {sram512_bitcell} -60 -20 0 0 0.3 0.3 {}
T {@name} 0 -110 0 0 0.2 0.2 {}
B 5 -102.5 -2.5 -97.5 2.5 {name=WL dir=in}
L 4 -100 0 -80 0 {}
T {WL} -70 -5 0 0 0.2 0.2 {}
B 5 -42.5 -102.5 -37.5 -97.5 {name=BL dir=inout}
L 4 -40 -100 -40 -80 {}
T {BL} -32 -72 0 0 0.2 0.2 {}
B 5 37.5 -102.5 42.5 -97.5 {name=BLB dir=inout}
L 4 40 -100 40 -80 {}
T {BLB} 48 -72 0 0 0.2 0.2 {}
B 5 97.5 -42.5 102.5 -37.5 {name=VDD dir=inout}
L 4 100 -40 80 -40 {}
T {VDD} 70 -45 0 1 0.2 0.2 {}
B 5 97.5 37.5 102.5 42.5 {name=VSS dir=inout}
L 4 100 40 80 40 {}
T {VSS} 70 35 0 1 0.2 0.2 {}
