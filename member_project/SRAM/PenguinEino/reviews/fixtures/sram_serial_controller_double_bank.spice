xdecode6 C0 C1B VDD E6 C3 C2B VSS AND4_X1
xdecode7 C0B C1 VDD E7 C3 C2B VSS AND4_X1
* noconn E7
xrx_low VDD net5 C0 C1 VSS NAND2
xrx net5 VDD RX C3B C2B VSS AND3_X1
xpc VDD PREB E0 PC_ON RESET VSS CLK DFFR
* noconn PC_ON
xwl_d VDD WL_D E3 E4 VSS OR2
xwl VDD net10 WL_D WL_EN RESET VSS CLK DFFR
xwrite_window E2 E3 E4 E5 VDD WRITE_WINDOW VSS OR4
xwrite_d VDD WRITE_D WRITE_WINDOW W VSS AND2_X1
xwrite VDD net11 WRITE_D WRITE_EN RESET VSS CLK DFFR
xwe_b VDD WE net6 VSS INV_X1
xtrack_e0 VDD net8 net6 E0 VSS AND2_X1
xtrack_window E3 VDD net7 E1 E2 VSS OR3
xtrack_later VDD net9 net7 W_B VSS AND2_X1
xtrack_d VDD TRACK_D net8 net9 VSS OR2
xtrack VDD SAE TRACK_D TRACK RESET VSS CLK DFFR
