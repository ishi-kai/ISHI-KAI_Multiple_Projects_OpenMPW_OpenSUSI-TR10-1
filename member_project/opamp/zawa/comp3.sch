C {devices/code.sym} -700 100 0 0 {name=TR-1um_MODELS
only_toplevel=true
format="tcleval( @value )"
value=".include $::LIB/ip62_models"
spice_ignore=false}
C {devices/code_shown.sym} -880 -430 0 0 {name=s1
only_toplevel=false
value="VSS_SRC VSS 0 DC 0
VDD_SRC VDD VSS DC 5

* CLK: 周期20ns、最初の20nsはリセット
VCLK CLK VSS PULSE(0 5 20n 3n 3n 15n 26n)

* 差動で振ってコモンモードを2.5Vに固定
*VINP_SRC VINP VSS PWL(0 2.480 1000n 2.520)
*VINM_SRC VINM VSS PWL(0 2.520 1000n 2.480)
VINM_SRC VINM VSS DC 2.5
VINP_SRC VINP VSS PWL(0 0 1000n 5)
* 次段バッファ相当の負荷
*CL1 OUT  VSS 100f
*CL2 OUTB VSS 100f

.options reltol=1e-4 abstol=1e-13 vntol=1e-7

.control
save all

tran 0.02n 1000n

* リセット期間の静的電流（ゼロなら正常）
meas tran i_static AVG i(vdd_src) from=15n to=19n

plot v(CLK)
plot v(VINP) v(VINM)
plot v(FN) v(FP)
plot v(OUT) v(OUTB)
plot i(vdd_src)
plot v(OUT)
plot v(OUTB)
.endc"}
